# URL pública donde corre este backend (usada para el callback del webhook)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# URL base de la API que consumirá el componente React (puede ser la misma)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# KEY del cliente usada por la página demo
NEXT_PUBLIC_DEMO_CLIENT_KEY=magon-demo-key
# Orígenes permitidos para CORS (separados por coma) o * para todos
CORS_ORIGINS=*

# Supabase (Project Settings -> API). Usar SOLO en el servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GalioPay (https://pay.galio.app/docs/api/introduccion)
# mock = no llama a la API real, devuelve un checkout simulado para desarrollo
GALIOPAY_MODE=mock
GALIOPAY_API_BASE_URL=https://pay.galio.app/api
GALIOPAY_CREATE_PAYMENT_PATH=/payment-links
GALIOPAY_CLIENT_ID=
GALIOPAY_API_KEY=
# GalioPay usa Bearer {API_KEY} + header x-client-id (bearer recomendado)
GALIOPAY_AUTH_MODE=bearer
GALIOPAY_API_KEY_HEADER=x-api-key
# true = crea links sandbox (solo se usa con GALIOPAY_MODE=live)
GALIOPAY_SANDBOX=true
# Firma HMAC-SHA256 (v1=... sobre "timestamp.rawBody"). Opcional.
GALIOPAY_WEBHOOK_SECRET=
# Token compartido por header/query (alternativa). Opcional.
GALIOPAY_WEBHOOK_TOKEN=
GALIOPAY_WEBHOOK_TOLERANCE=300
GALIOPAY_CURRENCY=ARS

# Regla de suscripción: vence el día 10, bloqueo desde el 11
SUBSCRIPTION_DUE_DAY=10
SUBSCRIPTION_TIMEZONE=America/Argentina/Buenos_Aires

# Claves internas de administración
ADMIN_API_KEY=change-me
# Panel /admin: usuario y contraseña. Si ADMIN_PASSWORD está vacío, se usa ADMIN_API_KEY.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Secreto para firmar la sesión del panel (opcional; si falta usa ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=
CRON_SECRET=change-me
