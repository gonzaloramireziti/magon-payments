{
  "name": "magon-payments",
  "version": "1.0.0",
  "private": true,
  "description": "Backend de suscripciones Magon (Next.js + Supabase + GalioPay) y paquete React magon-pay-react",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:react": "npm --workspace magon-pay-react run build",
    "pack:react": "npm run build:react && npm --workspace magon-pay-react pack",
    "predev": "npm run build:react",
    "dev": "next dev",
    "prebuild": "npm run build:react",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@mantine/core": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@mantine/modals": "^7.17.8",
    "@mantine/notifications": "^7.17.8",
    "@mantine/spotlight": "^7.17.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.47.10",
    "@tabler/icons-react": "^3.50.0",
    "next": "^15.1.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.7.3"
  }
}
