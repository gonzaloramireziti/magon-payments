# URL pública donde corre este backend (usada para el callback del webhook)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# URL base de la API que consumirá el componente React (puede ser la misma)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# KEY del cliente usada por la página demo
NEXT_PUBLIC_DEMO_CLIENT_KEY=magon-demo-key

# Supabase (Project Settings -> API). Usar SOLO en el servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GalioPay
# mock = no llama a la API real, devuelve un checkout simulado para desarrollo
GALIOPAY_MODE=mock
GALIOPAY_API_BASE_URL=
GALIOPAY_CREATE_PAYMENT_PATH=/v1/payments
GALIOPAY_CLIENT_ID=
GALIOPAY_API_KEY=
# bearer | header | basic | body
GALIOPAY_AUTH_MODE=bearer
GALIOPAY_API_KEY_HEADER=x-api-key
# Firma HMAC-SHA256 del body crudo (opcional)
GALIOPAY_WEBHOOK_SECRET=
# Token compartido por header/query (opcional)
GALIOPAY_WEBHOOK_TOKEN=
GALIOPAY_CURRENCY=ARS

# Regla de suscripción: vence el día 10, bloqueo desde el 11
SUBSCRIPTION_DUE_DAY=10
SUBSCRIPTION_TIMEZONE=America/Argentina/Buenos_Aires

# Claves internas de administración
ADMIN_API_KEY=change-me
CRON_SECRET=change-me
