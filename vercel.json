{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/invoices",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/uptime",
      "schedule": "30 12 * * *"
    }
  ]
}
